@page "/"
@rendermode InteractiveServer

<PageTitle>AutoPi Dashboard</PageTitle>

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Roboto+Mono:wght@300;400&display=swap');

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
        --bg:     #8c8c8f;
        --card:   #8c8c8f;
        --border: #1f1f23;
        --txt:    #070707;
        --muted:  #fa0404;
        --dim:    #3a3a46;
        --crit:   #ff3333;
        --accent: #4a7fa5;
        --fn:     'Inter', system-ui, sans-serif;

    }

    body { background: var(--bg); }
</style>

@if (DtcPresent)
{
    <div class="dtc-bar">
        <span class="dtc-label">CHECK ENGINE</span>
        <span class="dtc-codes">@string.Join("  ·  ", DtcCodes)</span>
    </div>
}

<div class="shell">

    <header class="hdr">
        <span class="hdr-title">AutoPi Telemetry</span>

        <div class="tabs">
            <button class="tab @(_activeTab == "live" ? "tab-active" : "")"
                    @onclick='() => SwitchTabAsync("live")'>
                DIRECT
            </button>
            <button class="tab @(_activeTab == "history" ? "tab-active" : "")"
                    @onclick='() => SwitchTabAsync("history")'>
                HISTORIQUE
            </button>
        </div>

    </header>

    @if (Streamer.IsStreaming)
    {
        <div class="demo-bar">
            <span class="demo-label">MODE PRÉSENTATION</span>
            <button class="demo-stop-btn" @onclick="StopDemoAsync">ARRÊTER</button>
        </div>
    }

    @if (_activeTab == "live")
    {
        <main class="grid">

            <!-- Vitesse -->
            <section class="primary-cell">
                <span class="metric-label">VITESSE</span>
                <span class="metric-value @(Speed > 200 ? "crit" : "")">@Speed</span>
                <span class="metric-unit">km / h</span>
                <svg class="sparkline" viewBox="0 0 120 24" preserveAspectRatio="none">
                    @if (SpeedHistory.Count > 1)
                    {
                        <polyline points="@SpeedChartPoints" class="spark-line" />
                    }
                </svg>
                <div class="metric-sub">
                    <span class="sub-label">MAX SESSION</span>
                    <span class="sub-value">@MaxSpeed <span class="sub-unit">km/h</span></span>
                </div>
            </section>

            <!-- RPM -->
            <section class="primary-cell">
                <span class="metric-label">RPM</span>
                <span class="metric-value @(IsShiftLightActive ? "crit" : "")">@Rpm.ToString("N0")</span>
                <span class="metric-unit">tr / min</span>
                <svg class="sparkline" viewBox="0 0 120 24" preserveAspectRatio="none">
                    @if (RpmHistory.Count > 1)
                    {
                        <polyline points="@RpmChartPoints" class="spark-line" />
                    }
                </svg>
                <div class="metric-sub">
                    <span class="sub-label">MAX SESSION</span>
                    <span class="sub-value">@MaxRpm.ToString("N0")</span>
                </div>
            </section>

            <!-- Side Panel -->
            <aside class="side-panel">

                <div class="side-row">
                    <span class="side-label">THROTTLE</span>
                    <div class="side-data">
                        <span class="side-value">@Throttle.ToString("F1")<span class="side-unit">%</span></span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@(Throttle.ToString("F0"))%"></div>
                    </div>
                </div>

                <div class="sep"></div>

                <div class="side-row">
                    <span class="side-label">CHARGE MOTEUR</span>
                    <div class="side-data">
                        <span class="side-value">@EngineLoad.ToString("F1")<span class="side-unit">%</span></span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill" style="width:@(EngineLoad.ToString("F0"))%"></div>
                    </div>
                </div>

                <div class="sep"></div>

                <div class="side-row">
                    <span class="side-label">TEMP. LIQUIDE</span>
                    <div class="side-data">
                        <span class="side-value @(CoolantTemp > 105 ? "crit" : "")">
                            @((int)CoolantTemp)<span class="side-unit">°C</span>
                        </span>
                    </div>
                    <div class="bar-track">
                        <div class="bar-fill @(CoolantTemp > 105 ? "bar-crit" : "")"
                             style="width:@(Math.Clamp((CoolantTemp - 40) / 80.0 * 100, 0, 100).ToString("F0"))%">
                        </div>
                    </div>
                </div>

                <div class="sep"></div>

                <div class="side-row track-row">
                    <button class="track-btn track-start"
                            @onclick="OpenStartModal"
                            disabled="@Processor.IsTrackingActive">
                        DÉMARRER UN TRAJET
                    </button>
                </div>

            </aside>

        </main>
    }

    @if (_activeTab == "history")
    {
        <div class="history-panel">
            <div class="hist-toolbar">
                <span class="hist-count">
                    @(_sessions.Count) trajet@(_sessions.Count > 1 ? "s" : "") enregistré@(_sessions.Count > 1 ? "s" : "")
                </span>
                <button class="hist-refresh" @onclick="LoadHistoryAsync" disabled="@_loadingHistory">
                    @(_loadingHistory ? "Chargement…" : "Actualiser")
                </button>
            </div>

            @if (_loadingHistory)
            {
                <p class="hist-msg">Chargement...</p>
            }
            else if (_historyError is not null)
            {
                <p class="hist-msg hist-error">Erreur : @_historyError</p>
            }
            else if (_sessions.Count == 0)
            {
                <p class="hist-msg">Aucun trajet enregistré pour le moment...</p>
            }
            else
            {
                <table class="hist-table">
                    <thead>
                        <tr>
                            <th>Trajet / Véhicule</th>
                            <th>Identifiant Appareil (VIN)</th>
                            <th>Début</th>
                            <th>Fin</th>
                            <th>Durée</th>
                            <th>RPM Max</th>
                            <th>Vit. Max</th>
                            <th>Distance</th>
                            <th>Charge moy.</th>
                            <th>Temp. moy.</th>
                            <th>Throttle moy.</th>
                            <th>Enreg.</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _sessions)
                        {
                            <tr>
                                <td style="font-family: var(--fn); font-size: 0.85rem; font-weight: 600;">
                                    @(string.IsNullOrWhiteSpace(s.Title) ? $"Trajet #{s.Id}" : s.Title)
                                </td>
                                <td class="muted">@s.DeviceId</td>
                                <td class="mono">@s.StartTime.ToLocalTime().ToString("dd/MM/yy HH:mm")</td>
                                <td class="mono @(s.EndTime is null ? "crit-txt" : "")">
                                    @(s.EndTime.HasValue
                                        ? s.EndTime.Value.ToLocalTime().ToString("dd/MM/yy HH:mm")
                                        : "En cours")
                                </td>
                                <td class="mono muted">@s.Duration</td>
                                <td class="mono @(s.MaxRpm >= 5500 ? "crit-txt" : "")">@s.MaxRpm.ToString("N0")</td>
                                <td class="mono @(s.MaxSpeed > 200 ? "crit-txt" : "")">@s.MaxSpeed</td>
                                <td class="mono">@s.TotalKm.ToString("F1") <span style="font-size:0.75em;opacity:0.6">km</span></td>
                                <td class="mono">@s.AvgEngineLoad.ToString("F1") <span style="font-size:0.75em;opacity:0.6">%</span></td>
                                <td class="mono @(s.AvgCoolantTemp > 105 ? "crit-txt" : "")">@((int)s.AvgCoolantTemp) <span style="font-size:0.75em;opacity:0.6">°C</span></td>
                                <td class="mono">@s.AvgThrottle.ToString("F1") <span style="font-size:0.75em;opacity:0.6">%</span></td>
                                <td class="mono muted">@s.RecordCount</td>
                                <td class="action-cell">
                                    @if (s.EndTime is null && Processor.IsTrackingActive)
                                    {
                                        <button class="btn-stop" @onclick="OpenStopModal" title="Terminer et archiver">TERMINER</button>
                                    }
                                    else
                                    {
                                        <button class="btn-resume"
                                                @onclick="() => ResumeSessionAsync(s.Id)"
                                                disabled="@Processor.IsTrackingActive"
                                                title="Reprendre ce trajet">Reprendre</button>
                                        @if (_demoSessionId == s.Id)
                                        {
                                            <button class="btn-demo-stop" @onclick="StopDemoAsync" title="Arrêter la démo">STOPPER</button>
                                        }
                                        else
                                        {
                                            <button class="btn-demo"
                                                    @onclick="() => StartDemoAsync(s.Id)"
                                                    disabled="@Streamer.IsStreaming"
                                                    title="Rejouer ce trajet en boucle">DÉMO</button>
                                        }
                                        <button class="btn-delete" @onclick="() => OpenDeleteModal(s.Id, s.Title)" title="Supprimer">Supprimer</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    }

</div>

@if (_showStartModal)
{
    <div class="modal-overlay" @onclick="CloseStartModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <span class="modal-title">NOM DU TRAJET</span>
            <input class="modal-input"
                   type="text"
                   placeholder="Ex : Trajet domicile -> travail"
                   maxlength="80"
                   @bind="_newTripTitle"
                   @bind:event="oninput"
                   @onkeydown="OnStartModalKeyDown"
                   autofocus />
            @if (_startModalError)
            {
                <span class="modal-error">Le nom du trajet est obligatoire.</span>
            }
            <div class="modal-actions">
                <button class="modal-btn modal-cancel" @onclick="CloseStartModal">Annuler</button>
                <button class="modal-btn modal-confirm" @onclick="ConfirmStartTrackingAsync">Commencer</button>
            </div>
        </div>
    </div>
}

@if (_showStopModal)
{
    <div class="modal-overlay" @onclick="CloseStopModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <span class="modal-title">TERMINER LE TRAJET</span>
            <p class="modal-warn">Voulez-vous terminer le trajet en cours ?</p>
            <div class="modal-actions">
                <button class="modal-btn modal-cancel" @onclick="CloseStopModal">Annuler</button>
                <button class="modal-btn modal-stop-confirm" @onclick="ConfirmStopAsync">Terminer</button>
            </div>
        </div>
    </div>
}

@if (_showDeleteModal)
{
    <div class="modal-overlay" @onclick="CloseDeleteModal">
        <div class="modal-box" @onclick:stopPropagation="true">
            <span class="modal-title">SUPPRIMER LE TRAJET</span>
            <p class="modal-warn">
                Voulez-vous supprimer <strong>@(_deleteTargetTitle is { Length: > 0 } t ? t : $"Trajet #{_deleteTargetId}")</strong> ?
                Cette action est irréversible.
            </p>
            <div class="modal-actions">
                <button class="modal-btn modal-cancel" @onclick="CloseDeleteModal">Annuler</button>
                <button class="modal-btn modal-delete" @onclick="ConfirmDeleteAsync">Supprimer</button>
            </div>
        </div>
    </div>
}
